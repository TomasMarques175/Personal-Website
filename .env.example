# Copy this file to .env and fill in your real secrets.
# Never commit the .env file with actual API keys.

# -------------------------------------------------------------------
# Embedding model used for semantic search
# -------------------------------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# -------------------------------------------------------------------
# LLM provider configuration
# Supported values: groq, huggingface, ollama, extractive
# extractive = no external model; returns retrieved context only
# -------------------------------------------------------------------
LLM_PROVIDER=groq

# --- Groq ---
# Sign up at https://console.groq.com/keys and paste the key below
GROQ_API_KEY=
# LLM_MODEL=llama-3.1-8b-instant

# --- Hugging Face ---
# HF_TOKEN=
# LLM_PROVIDER=huggingface
# LLM_MODEL=mistralai/Mistral-7B-Instruct-v0.3

# --- Ollama ---
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# LLM_MODEL=llama3.2

# -------------------------------------------------------------------
# Frontend access settings
# Comma-separated list of allowed origins in the browser
# -------------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# -------------------------------------------------------------------
# RAG indexing settings
# -------------------------------------------------------------------
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K=4
